[Unit]
Description=Adaptive Ampelsteuerung der Modellkreuzung
After=local-fs.target

[Service]
Type=simple
ExecStart=/usr/bin/python3 -m ampel.main -config /etc/ampel/config.toml
WorkingDirectory=/usr/local/lib/ampel
Environment=PYTHONPATH=/usr/local/lib/ampel
User=ampel
Group=gpio
SupplementaryGroups=spi
Restart=always
RestartSec=2
KillSignal=SIGTERM
TimeoutStopSec=10
RuntimeDirectory=ampel
RuntimeDirectoryMode=0750
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
