[Unit]
Description=Adaptive Ampelsteuerung der Modellkreuzung
Documentation=file:/usr/local/share/doc/ampel/aufbau.md
After=local-fs.target

[Service]
Type=simple
ExecStart=/usr/local/bin/ampel -config /etc/ampel/config.yaml
User=ampel
Group=gpio
SupplementaryGroups=spi
Restart=always
RestartSec=2
KillSignal=SIGTERM
TimeoutStopSec=10
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
DevicePolicy=closed
DeviceAllow=/dev/gpiochip0 rw
DeviceAllow=/dev/spidev0.0 rw
DeviceAllow=/dev/spidev1.0 rw
RuntimeDirectory=ampel
RuntimeDirectoryMode=0750
PrivateNetwork=true
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
