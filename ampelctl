#!/usr/bin/env python3
import http.client
import json
import socket
import sys

SOCKET = "/run/ampel/ampel.sock"

USAGE = """Aufruf: ampelctl [-socket pfad] befehl

  status      Zustand der Kreuzung anzeigen
  an          Anlage einschalten
  aus         Anlage ausschalten
  not an      Notzustand einschalten, alle Lichter blinken gelb
  not aus     Notzustand beenden, die Anlage beginnt bei Allrot
"""


class Connection(http.client.HTTPConnection):
    def __init__(self, path):
        super().__init__("anlage")
        self.path_to_socket = path

    def connect(self):
        self.sock = socket.socket(socket.AF_UNIX)
        self.sock.settimeout(3)
        self.sock.connect(self.path_to_socket)


def main(args):
    path = SOCKET
    if args[:1] == ["-socket"]:
        path, args = args[1], args[2:]
    if not args:
        print(USAGE, end="")
        return 0

    command = args[0]
    if command == "status":
        return show(request(path, "GET", "/status"))
    if command in ("an", "aus"):
        request(path, "POST", f"/hauptschalter/{command}")
    elif command == "not" and args[1:2] and args[1] in ("an", "aus"):
        request(path, "POST", f"/notschalter/{args[1]}")
    else:
        print(f"unbekannter Befehl {' '.join(args)!r}", file=sys.stderr)
        return 1
    print("erledigt")
    return 0


def request(path, method, route):
    connection = Connection(path)
    connection.request(method, route)
    response = connection.getresponse()
    body = response.read()
    if response.status >= 300:
        raise SystemExit(f"{response.status} {response.reason}: {body.decode().strip()}")
    return json.loads(body) if body else None


def show(status):
    print(f"Anlage      {'laeuft' if status['an'] else 'aus'}")
    print(f"Notzustand  {'ja' if status['notzustand'] else 'nein'}")
    print(f"Phase       {status['phase']}")
    print(f"Verlaengert {status['verlaengerungen']} mal")
    for name in sorted(status["gruenzeiten_s"]):
        print(f"  {name:<5} {status['signalbilder'][name]:<8} {status['gruenzeiten_s'][name]:>2} s")
    return 0


if __name__ == "__main__":
    try:
        sys.exit(main(sys.argv[1:]))
    except OSError as error:
        print("Fehler:", error, file=sys.stderr)
        sys.exit(1)
